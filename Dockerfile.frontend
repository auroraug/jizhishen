FROM node:22-alpine AS build
WORKDIR /site
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts --no-audit --no-fund
COPY app ./app
COPY build ./build
COPY worker ./worker
COPY public ./public
COPY .openai ./.openai
COPY next.config.ts tsconfig.json vite.config.ts postcss.config.mjs next-env.d.ts ./
RUN npm run build
FROM node:22-alpine
WORKDIR /site
COPY --from=build /site /site
ENV HOST=0.0.0.0 PORT=3000
EXPOSE 3000
CMD ["npm","run","start"]
